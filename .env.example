# Email — Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here

# AI — Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Maps — Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database — Supabase (https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Schwab API (https://developer.schwab.com) — set USE_SCHWAB=true to enable
SCHWAB_CLIENT_ID=your_schwab_client_id_here
SCHWAB_CLIENT_SECRET=your_schwab_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1
USE_SCHWAB=false
